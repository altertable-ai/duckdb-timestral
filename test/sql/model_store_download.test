# name: test/sql/model_store_download.test
# description: downloading a model through timestral_model_url verifies it and leaves no partial file
# group: [sql]

require timestral

require-env TIMESTRAL_MODEL_DIR

statement ok
SET GLOBAL timestral_model_url = '${TIMESTRAL_MODEL_DIR}';

statement ok
SET GLOBAL timestral_cache_dir = '__TEST_DIR__/download_cache';

query I
SELECT cached FROM timestral_models() WHERE size = '5m';
----
false

# Concurrent connections race to download and initialize the same model.
concurrentloop connection 0 8

query I
SELECT len(timestral_forecast(i, sin(i)::DOUBLE, 3)) FROM range(64) r(i);
----
3

endloop

query I
SELECT cached FROM timestral_models() WHERE size = '5m';
----
true

query I
SELECT count(*) FROM glob('__TEST_DIR__/download_cache/*.tmp*');
----
0
