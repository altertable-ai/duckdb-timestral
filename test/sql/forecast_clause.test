# name: test/sql/forecast_clause.test
# description: FROM ... TIMESTRAL_FORECAST (...) and timestral_forecast(value ORDER BY ts HORIZON n ...)
# group: [sql]

require timestral

require-env TIMESTRAL_MODEL_PATH

statement ok
SET timestral_model_path = '{TIMESTRAL_MODEL_PATH}';

statement ok
CREATE TABLE sales AS
SELECT g AS store, g * 1000 + 7 AS store_id, TIMESTAMP '2026-01-01' + INTERVAL (i) HOUR AS ts, 10 * g + sin(i / 6) AS amount
FROM range(3) a(g), range(200) b(i);

# same rows as the hand-written GROUP BY + unnest; PARTITION BY store does not also pick up store_id
query I
SELECT count(*) = 3 * 5 AND bool_and(a.forecast = b.forecast AND a.q99 = b.q99) FROM
  (FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 5)) a
  JOIN (SELECT store, unnest(timestral_forecast(ts, amount, 5), recursive := true) FROM sales GROUP BY store) b
  USING (store, ts);
----
true

query I
SELECT list(column_name ORDER BY ordinal) FROM (
  SELECT column_name, row_number() OVER () AS ordinal FROM (DESCRIBE FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 2)));
----
[store, ts, forecast, q01, q05, q10, q15, q20, q25, q30, q35, q40, q45, q50, q55, q60, q65, q70, q75, q80, q85, q90, q95, q99]

# the time column keeps its name; an expression is named ts, and an unaliased partition keeps DuckDB's name
statement ok
CREATE TABLE renamed AS SELECT store AS shop, ts AS sold_at, amount FROM sales;

query I
SELECT list(column_name) FILTER (WHERE column_name NOT LIKE 'q%') FROM (DESCRIBE FROM renamed TIMESTRAL_FORECAST (amount PARTITION BY shop ORDER BY sold_at HORIZON 1));
----
[shop, sold_at, forecast]

query I
SELECT list(column_name) FILTER (WHERE column_name NOT LIKE 'q%') FROM (DESCRIBE FROM renamed TIMESTRAL_FORECAST (amount PARTITION BY shop % 2 ORDER BY sold_at + INTERVAL 1 MINUTE HORIZON 1));
----
['(shop % 2)', ts, forecast]

# without PARTITION BY the whole input is one series
query II
SELECT count(*), min(ts) FROM (SELECT ts, amount FROM sales WHERE store = 1) TIMESTRAL_FORECAST (amount ORDER BY ts HORIZON 3);
----
3	2026-01-09 08:00:00

# EVERY and USING MODEL, in any order and any case
query II
SELECT count(*), min(ts) FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 2 EVERY INTERVAL '30 minutes');
----
6	2026-01-09 07:30:00

query I
SELECT count(*) FROM sales timestral_forecast (amount partition by store order by ts using model '5m' every interval 1 hour horizon 2);
----
6

# the clause and the call give the same forecasts
query I
SELECT bool_and(a.forecast = b.forecast) FROM
  (FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 3 EVERY INTERVAL 1 HOUR USING MODEL '5m')) a
  JOIN (SELECT store, unnest(timestral_forecast(amount ORDER BY ts HORIZON 3 EVERY INTERVAL 1 HOUR USING MODEL '5m'), recursive := true)
        FROM sales GROUP BY store) b
  USING (store, ts);
----
true

query I
SELECT typeof(timestral_forecast(amount ORDER BY sold_at HORIZON 1))[1:24] FROM renamed;
----
STRUCT(sold_at TIMESTAMP

# WITH HISTORY: observed rows, then forecast rows
query IIIII
SELECT count(*) FILTER (WHERE NOT is_forecast), count(*) FILTER (WHERE is_forecast),
       bool_and(amount IS NULL) FILTER (WHERE is_forecast), bool_and(forecast IS NULL) FILTER (WHERE NOT is_forecast),
       max(ts) FILTER (WHERE is_forecast)
FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 4 WITH HISTORY);
----
600	12	true	true	2026-01-09 11:00:00

query I
SELECT list(column_name) FILTER (WHERE column_name NOT LIKE 'q%') FROM (DESCRIBE FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 1 WITH HISTORY));
----
[store, ts, amount, forecast, is_forecast]

# aliases on the source and on the result; joins after the clause
query I
SELECT count(*) FROM sales s TIMESTRAL_FORECAST (s.amount PARTITION BY s.store ORDER BY s.ts HORIZON 2) AS f(shop) WHERE f.shop >= 1;
----
4

query I
SELECT count(*) FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 2) f JOIN (SELECT DISTINCT store FROM sales) USING (store);
----
6

# `forecast` stays an ordinary name
query I
SELECT forecast FROM (SELECT 1 AS forecast) forecast;
----
1

# HORIZON can be a prepared parameter
statement ok
PREPARE p AS SELECT count(*) FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON $1);

query I
EXECUTE p(4);
----
12

# views and macros store the lowered SQL
statement ok
CREATE VIEW v AS FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 2);

query I
SELECT count(*) FROM v;
----
6

statement ok
CREATE MACRO forecast_sales(h) AS TABLE FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON h);

query I
SELECT count(*) FROM forecast_sales(3);
----
9

# errors
statement error
FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts);
----
Parser Error: TIMESTRAL_FORECAST requires HORIZON, the number of future steps

statement error
FROM sales TIMESTRAL_FORECAST (amount ORDER BY ts HORIZON 1 HORIZON 2);
----
Parser Error: TIMESTRAL_FORECAST: HORIZON is given more than once

statement error
FROM sales TIMESTRAL_FORECAST (amount ORDER BY ts DESC HORIZON 1);
----
Parser Error: TIMESTRAL_FORECAST: ORDER BY must be ascending

statement error
FROM sales s (amount ORDER BY ts HORIZON 1);
----
Parser Error: syntax error at or near "(": expected TIMESTRAL_FORECAST (...) after sales AS s

statement error
SELECT timestral_forecast(amount ORDER BY ts HORIZON 1 WITH HISTORY) FROM sales;
----
Parser Error: WITH HISTORY is only supported in FROM ... TIMESTRAL_FORECAST (...)

statement error
FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 1 USING MODEL '7b');
----
Invalid Input Error: timestral: unknown model size '7b'

statement error
FROM sales TIMESTRAL_FORECAST (amount PARTITION BY store ORDER BY ts HORIZON 1 EVERY 5);
----
Binder Error: timestral: EVERY for TIMESTAMP values must be an INTERVAL
