# name: test/sql/model_store_local.test
# description: an explicit timestral_model_path is reported by timestral_models()
# group: [sql]

require timestral

require-env TIMESTRAL_MODEL_PATH

statement ok
SET timestral_model_path = '{TIMESTRAL_MODEL_PATH}';

query I
SELECT current_setting('timestral_model_path') = '{TIMESTRAL_MODEL_PATH}';
----
true
